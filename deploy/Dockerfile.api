# syntax=docker/dockerfile:1

# ---------- builder ----------
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/data-client/package.json packages/data-client/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --no-audit --no-fund

COPY packages ./packages
COPY apps/api ./apps/api

RUN npm run build -w @examdump/shared \
 && npm run build -w @examdump/data-client \
 && npm run build -w @examdump/api \
 && npm prune --omit=dev

# ---------- runner ----------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NODE_OPTIONS=--enable-source-maps
RUN apk add --no-cache curl \
 && addgroup -S examdump && adduser -S examdump -G examdump

RUN printf '{"name":"examdump-api","private":true,"type":"module"}\n' > package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/dist ./dist

USER examdump
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:4000/api/health/live || exit 1
CMD ["node", "dist/index.js"]