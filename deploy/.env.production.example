# ---------------------------------------------------------------------------
# Production environment reference (for Doppler `prd` config).
# Never commit a filled-in copy. Run the stack with `doppler run -- docker compose up`.
# ---------------------------------------------------------------------------
NODE_ENV=production
PUBLIC_WEB_URL=https://examdump.example.com
PUBLIC_API_URL=https://examdump.example.com
WEB_ORIGIN=https://examdump.example.com

# PostgreSQL. When using the bundled compose service, postgres/user/db are set
# with POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and DATABASE_URL is
# derived automatically. For a managed database, set DATABASE_URL directly.
POSTGRES_USER=examdump
POSTGRES_PASSWORD=<strong random password>
POSTGRES_DB=examdump
DATABASE_URL=postgres://examdump:<password>@postgres:5432/examdump
DATABASE_SSL=false

JWT_ACCESS_SECRET=<64+ random chars>
JWT_REFRESH_SECRET=<64+ random chars, different>
PASSWORD_PEPPER=<64+ random chars>
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_ID=<optional>
GOOGLE_CLIENT_SECRET=<optional>

# ExamDump Mail - Gmail STARTTLS. App Password goes in Doppler only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=examdump.official@gmail.com
SMTP_PASS=<Google App Password via Doppler>
MAIL_FROM=ExamDump <examdump.official@gmail.com>
MAIL_REPLY_TO=examdump.official@gmail.com
MAIL_ENABLED=true
MAIL_MAX_ATTEMPTS=3
MAIL_RATE_MAX=5
MAIL_RATE_WINDOW_MS=60000

GITHUB_TOKEN=<read-only token for the private exam-data repo>
DATASET_OWNER=ajayk134
DATASET_REPO=exam-data
DATASET_BRANCH=main

AI_API_KEY=<optional, enables AI explanations>
AI_MODEL=gpt-4o-mini

ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=<strong bootstrap password>

# ExamDump Pay - keep disabled until a provider is authorised.
PAYMENTS_ENABLED=false
ALLOW_MOCK_PAYMENTS=true
PAYMENT_ADAPTER=none
PAYMENT_METHODS=upi,card
PAYMENT_MIN_AMOUNT_MINOR=100
PAYMENT_MAX_AMOUNT_MINOR=10000000
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=<optional, when enabling live payments>
RAZORPAY_KEY_SECRET=<optional>
RAZORPAY_WEBHOOK_SECRET=<optional>
DEFAULT_CURRENCY=INR
LOG_LEVEL=info
RATE_LIMIT_MAX=300
# --- ExamDump Mail: durable queue -------------------------------------------
MAIL_QUEUE_ENABLED=true
MAIL_BATCH_SIZE=10
MAIL_WORKER_INTERVAL_SECONDS=20
MAIL_REMINDER_CRON=0 9 * * *
MAIL_HOURLY_SEND_LIMIT=100
MAIL_CAMPAIGN_BATCH_SIZE=50
MAIL_LOCK_LEASE_SECONDS=300
