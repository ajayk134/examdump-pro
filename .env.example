# ---------------------------------------------------------------------------
# ExamDump Pro - local environment template
# DO NOT put real secrets here. Inject them with Doppler:
#   doppler run -- npm run dev
# This file documents every variable the application understands.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (self-hosted). Use a dedicated database and a strong password.
DATABASE_URL=postgres://examdump:change-me@localhost:5432/examdump
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_APP_NAME=examdump-api

# Auth
JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-64-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
PASSWORD_PEPPER=
BCRYPT_ROUNDS=12

# Google OAuth (optional). Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# ExamDump Mail (transactional email via Gmail SMTP)
# ---------------------------------------------------------------------------
# Gmail requires an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords). A normal account password will be rejected.
# Store the App Password in Doppler:  examdump-pro / prd  as SMTP_PASS.
# NEVER commit it, and never expose it to the browser.
#
# Port 587 uses STARTTLS, which requires SMTP_SECURE=false (plaintext connect,
# then upgrade). Use SMTP_SECURE=true only for implicit TLS on port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=examdump.official@gmail.com
SMTP_PASS=
MAIL_FROM="ExamDump <examdump.official@gmail.com>"
# Reply-To shown in the mail client (defaults to SMTP_USER).
MAIL_REPLY_TO=examdump.official@gmail.com
# Base URL for links inside emails (defaults to PUBLIC_WEB_URL).
MAIL_PUBLIC_URL=
# Master switch. false = every send is logged as "suppressed" and skipped.
MAIL_ENABLED=true
# Delivery retries: first attempt + retries, with exponential backoff.
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_BASE_MS=500
# Per-recipient throttle, prevents mail-bombing a single address.
MAIL_RATE_MAX=5
MAIL_RATE_WINDOW_MS=60000
# SMTP connection/greeting/socket timeout.
MAIL_TIMEOUT_MS=15000

# Exam dataset (GitHub only - NEVER stored in MongoDB)
GITHUB_TOKEN=
DATASET_OWNER=ajayk134
DATASET_REPO=exam-data
DATASET_BRANCH=main
DATASET_CACHE_TTL_SECONDS=300
DATASET_MAX_QUESTIONS_PER_REQUEST=200

# Product rules
FREE_QUESTIONS_PER_EXAM=5
PREMIUM_DAILY_QUESTION_LIMIT=0
ENABLE_DATASET_SYNC=true
DATASET_SYNC_CRON=0 3 * * *

# AI assistance (optional; feature hidden when unset)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Admin bootstrap (first run only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Observability
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# ---------------------------------------------------------------------------
# ExamDump Pay
# ---------------------------------------------------------------------------
# Payments stay DISABLED until a payment provider is authorised for this
# merchant account. While false the platform is free-tier only and no checkout
# is offered. There is no simulated success in production.
PAYMENTS_ENABLED=false
ALLOW_MOCK_PAYMENTS=true
# Which adapter takes live money: none | razorpay | hyperswitch.
# 'hyperswitch' is not runnable on this deployment (needs extra infrastructure)
# and reports as "coming soon" rather than pretending to work.
PAYMENT_ADAPTER=none
# Methods offered by the checkout UI once an adapter is live.
PAYMENT_METHODS=upi,card
# Server-side amount guard (minor units, i.e. paise).
PAYMENT_MIN_AMOUNT_MINOR=100
PAYMENT_MAX_AMOUNT_MINOR=10000000
PAYMENT_MAX_REFUNDS=5
# Tolerance for webhook timestamp checks (seconds).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- UPI self-collection -----------------------------------------------------
# Most of these can also be set from Admin -> UPI -> Gateway settings, which
# stores them in the `upi_config` table and takes precedence over this file.
# Leave them blank here if you intend to configure the gateway in the dashboard.

# The UPI ID that receives money.
UPI_PAYEE_VPA=
UPI_PAYEE_NAME=ExamDump
UPI_ORDER_TTL_MINUTES=15
# Keep false. Automatic approval lets a bank email settle a payment with no human.
UPI_AUTO_APPROVE=false
UPI_NOTIFICATION_MAX_PAISE=50000000
# Seconds between polls; 0 disables polling entirely.
UPI_GMAIL_POLL_SECONDS=60
# Whole-mailbox search. `is:unread` is unsafe: this account never marks mail read,
# so it selects everything oldest-first and silently drops new payments.
UPI_GMAIL_QUERY=in:anywhere
UPI_GMAIL_LABEL=INBOX
# Mailbox credentials (optional; the dashboard Connect flow supersedes them).
UPI_GMAIL_USER=
UPI_GOOGLE_CLIENT_ID=
UPI_GOOGLE_CLIENT_SECRET=
UPI_GOOGLE_REFRESH_TOKEN=
# Exact redirect URI registered on the Google OAuth client. Required for the
# dashboard Connect flow to complete.
UPI_OAUTH_REDIRECT_URI=
# Encrypts dashboard-entered credentials at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it, the dashboard Connect flow is disabled and only the values above
# are used. Never commit a real key, and never expose it to the dashboard.
UPI_SECRETS_KEY=
# Optional SMS bridge shared secret. Not needed for Gmail-only detection.
UPI_SMS_INGEST_SECRET=

# Legacy/alternate provider settings (kept for the existing reconciliation code).
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=INR

# --- ExamDump Mail: durable queue -------------------------------------------
# Durable Postgres-backed outbound queue. The worker runs inside the API process.
MAIL_QUEUE_ENABLED=true
MAIL_BATCH_SIZE=10
MAIL_WORKER_INTERVAL_SECONDS=20
MAIL_REMINDER_CRON=0 9 * * *
# Stay well under the Gmail per-hour ceiling (~100-150 for a consumer account).
MAIL_HOURLY_SEND_LIMIT=100
MAIL_CAMPAIGN_BATCH_SIZE=50
MAIL_LOCK_LEASE_SECONDS=300
