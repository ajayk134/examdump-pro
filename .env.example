# ---------------------------------------------------------------------------
# ExamDump Pro - local environment template
# DO NOT put real secrets here. Inject them with Doppler:
#   doppler run -- npm run dev
# This file documents every variable the application understands.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (self-hosted). Use a dedicated database and a strong password.
DATABASE_URL=postgres://examdump:change-me@localhost:5432/examdump
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_APP_NAME=examdump-api

# Auth
JWT_ACCESS_SECRET=change-me-64-random-chars
JWT_REFRESH_SECRET=change-me-64-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
COOKIE_SECURE=false
PASSWORD_PEPPER=
BCRYPT_ROUNDS=12

# Google OAuth (optional). Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (transactional). If SMTP is not configured, emails are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ExamDump Pro <no-reply@examdump.pro>"

# Exam dataset (GitHub only - NEVER stored in MongoDB)
GITHUB_TOKEN=
DATASET_OWNER=ajayk134
DATASET_REPO=exam-data
DATASET_BRANCH=main
DATASET_CACHE_TTL_SECONDS=300
DATASET_MAX_QUESTIONS_PER_REQUEST=200

# Product rules
FREE_QUESTIONS_PER_EXAM=5
PREMIUM_DAILY_QUESTION_LIMIT=0
ENABLE_DATASET_SYNC=true
DATASET_SYNC_CRON=0 3 * * *

# AI assistance (optional; feature hidden when unset)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Admin bootstrap (first run only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Observability
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# Payments are intentionally DISABLED until a provider is approved.
PAYMENTS_ENABLED=false
ALLOW_MOCK_PAYMENTS=true
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEFAULT_CURRENCY=INR
